{
  "targets": {
    "vault": "http://vault.sliccy.ai",
    "seven": "http://seven.sliccy.ai"
  },
  "variants": {
    "prompt": 2000,
    "lagging": 8000
  },
  "navigation": [
    {
      "id": "C1.href",
      "trigger": "href",
      "setup": ["probe"],
      "expect": "beacon",
      "lanes": ["raw", "cli", "kernel"]
    },
    {
      "id": "C1.replace",
      "trigger": "replace",
      "setup": ["probe"],
      "expect": "beacon",
      "lanes": ["raw", "cli"]
    },
    {
      "id": "C1.form",
      "trigger": "form",
      "setup": ["probe"],
      "expect": "beacon",
      "lanes": ["raw", "cli"]
    },
    {
      "id": "C2.302",
      "trigger": "href",
      "hop": {
        "n": 1,
        "code": 302
      },
      "setup": ["probe"],
      "expect": "beacon",
      "lanes": ["raw", "cli", "kernel"]
    },
    {
      "id": "C2.307",
      "trigger": "href",
      "hop": {
        "n": 1,
        "code": 307
      },
      "setup": ["probe"],
      "expect": "beacon",
      "lanes": ["raw", "cli"]
    },
    {
      "id": "C2.twohop",
      "trigger": "href",
      "hop": {
        "n": 2,
        "code": 302
      },
      "setup": ["probe"],
      "expect": "beacon",
      "lanes": ["raw", "cli"]
    },
    {
      "id": "C3.popup",
      "trigger": "popup",
      "setup": ["probe", "autoattach"],
      "expect": "popup",
      "lanes": ["raw", "cli", "kernel"],
      "refusedAtRegistration": ["Target.setAutoAttach"]
    },
    {
      "id": "C4.iframe",
      "trigger": "iframe",
      "setup": ["probe"],
      "expect": "iframe",
      "lanes": ["raw", "cli"]
    },
    {
      "id": "C5.fulfill",
      "trigger": "href",
      "setup": ["fetch"],
      "intercept": "fulfill",
      "expect": "fulfill",
      "lanes": ["raw", "cli"]
    },
    {
      "id": "C5.continue-url",
      "trigger": "href",
      "setup": ["fetch"],
      "intercept": "continue-url",
      "expect": "rewrite",
      "lanes": ["raw"]
    },
    {
      "id": "C5.paused",
      "trigger": "href",
      "setup": ["fetch"],
      "intercept": "continue",
      "expect": "paused",
      "lanes": ["raw"]
    },
    {
      "id": "E1",
      "trigger": "href",
      "setup": ["onload"],
      "expect": "beacon",
      "lanes": ["raw"]
    },
    {
      "id": "E2",
      "trigger": "href",
      "setup": ["binding", "probe"],
      "expect": "binding",
      "lanes": ["raw"]
    },
    {
      "id": "E3",
      "trigger": "href",
      "csp": true,
      "setup": ["bypasscsp", "probe"],
      "expect": "beacon",
      "lanes": ["raw"]
    },
    {
      "id": "E5",
      "trigger": "href",
      "setup": ["console", "probe"],
      "expect": "console",
      "lanes": ["raw"]
    },
    {
      "id": "B2",
      "trigger": "href",
      "setup": ["headers"],
      "expect": "header",
      "lanes": ["raw"]
    }
  ],
  "cookies": [
    {
      "id": "C6.getCookies",
      "method": "Network.getCookies",
      "session": "page",
      "params": {
        "urls": ["$target/", "$ordinary/"]
      },
      "expect": "read",
      "lanes": ["raw", "cli"]
    },
    {
      "id": "C6.getAllCookies",
      "method": "Network.getAllCookies",
      "session": "page",
      "params": {},
      "expect": "read",
      "lanes": ["raw"]
    },
    {
      "id": "C6.setCookie",
      "method": "Network.setCookie",
      "session": "page",
      "params": {
        "name": "probe",
        "value": "$key",
        "url": "$target/"
      },
      "expect": "set",
      "lanes": ["raw"]
    },
    {
      "id": "C6.deleteCookies",
      "method": "Network.deleteCookies",
      "session": "page",
      "params": {
        "name": "del",
        "url": "$target/"
      },
      "expect": "delete",
      "lanes": ["raw"]
    },
    {
      "id": "C6.storage-getCookies",
      "method": "Storage.getCookies",
      "params": {},
      "expect": "read",
      "lanes": ["raw"]
    },
    {
      "id": "C6.clearDataForOrigin",
      "method": "Storage.clearDataForOrigin",
      "params": {
        "origin": "$target",
        "storageTypes": "cookies,local_storage"
      },
      "control": "alt",
      "expect": "clear",
      "lanes": ["raw"],
      "session": "page"
    }
  ]
}
