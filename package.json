{
  "name": "@ai-ecoverse/slicc-cdp",
  "version": "0.0.0",
  "description": "SLICC's CDP layer: client, browser API, transports, HAR, and ARIA snapshot",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-ecoverse/slicc-cdp.git"
  },
  "engines": {
    "node": ">=24"
  },
  "fledgling": {
    "provider": "github",
    "workflow": "release.yml",
    "repo": "ai-ecoverse/slicc-cdp",
    "publish": true
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "bin/playwright-cli.wasm",
    "bin/curlwright.wasm"
  ],
  "slicc": {
    "abi": "wasi",
    "commands": {
      "playwright-cli": {
        "wasm": "bin/playwright-cli.wasm"
      },
      "curlwright": {
        "wasm": "bin/curlwright.wasm"
      }
    }
  },
  "scripts": {
    "prepare": "lefthook install",
    "build:wasm": "cargo build --release --target wasm32-wasip1 -p playwright-cli -p curlwright && mkdir -p bin && cp target/wasm32-wasip1/release/playwright-cli.wasm bin/playwright-cli.wasm && cp target/wasm32-wasip1/release/curlwright.wasm bin/curlwright.wasm",
    "prepublishOnly": "npm run build:wasm",
    "lint": "slicc-lint",
    "format": "biome check --write .",
    "test": "true",
    "trust": "npx fledgling sync -y --skip-publish",
    "trust:dry": "npx fledgling sync --dry-run -y --skip-publish",
    "release": "semantic-release"
  },
  "devDependencies": {
    "@ai-ecoverse/slicc-shared-web": "1.11.0",
    "@biomejs/biome": "2.5.15",
    "lefthook": "2.1.16",
    "semantic-release": "25.0.9"
  }
}
