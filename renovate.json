{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>ai-ecoverse/slicc-shared-web"],
  "packageRules": [
    {
      "matchFileNames": ["packages/sliccy-browser/package.json"],
      "matchPackageNames": ["@ai-ecoverse/slicc-cdp"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "sliccy-browser",
      "bumpVersion": "patch"
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["ai-ecoverse/slicc-shared-web"],
      "additionalBranchPrefix": "workflow-",
      "commitMessageTopic": "slicc-shared-web reusable workflows",
      "semanticCommitType": "ci"
    }
  ]
}
