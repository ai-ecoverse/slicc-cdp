{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>ai-ecoverse/slicc-shared-web"],
  "packageRules": [
    {
      "matchManagers": ["npm", "cargo"],
      "matchPackageNames": ["@ai-ecoverse/slicc-browsers", "slicc-browsers"],
      "groupName": "slicc-browsers catalog and vectors",
      "groupSlug": "slicc-browsers-catalog-vectors",
      "rangeStrategy": "pin"
    },
    {
      "matchFileNames": ["packages/sliccy-browser/package.json"],
      "matchPackageNames": ["@ai-ecoverse/slicc-cdp"],
      "semanticCommitType": "chore",
      "semanticCommitScope": "sliccy-browser",
      "bumpVersion": "patch"
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["ai-ecoverse/slicc-shared-web"],
      "additionalBranchPrefix": "workflow-",
      "commitMessageTopic": "slicc-shared-web reusable workflows",
      "semanticCommitType": "ci"
    }
  ],
  "customDatasources": {
    "chrome-for-testing-beta": {
      "defaultRegistryUrlTemplate": "https://googlechromelabs.github.io/chrome-for-testing/last-known-good-versions.json",
      "transformTemplates": ["{\"releases\": [{\"version\": channels.Beta.version}]}"]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^package\\.json$/"],
      "matchStrings": ["\"chrome\":\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+\\.\\d+)\""],
      "depNameTemplate": "chrome-for-testing",
      "datasourceTemplate": "custom.chrome-for-testing-beta",
      "versioningTemplate": "loose"
    }
  ]
}
