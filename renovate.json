{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>ai-ecoverse/slicc-shared-web"],
  "packageRules": [
    {
      "matchManagers": ["npm", "cargo"],
      "matchPackageNames": ["@ai-ecoverse/slicc-browsers", "slicc-browsers"],
      "groupName": "slicc-browsers catalog and vectors",
      "groupSlug": "slicc-browsers-catalog-vectors",
      "rangeStrategy": "bump"
    },
    {
      "description": "sliccy-browser pins slicc-cdp by hand, in the pull request that bumps its own version for ci.yml to publish.",
      "matchFileNames": ["packages/sliccy-browser/package.json"],
      "matchPackageNames": ["@ai-ecoverse/slicc-cdp"],
      "enabled": false
    },
    {
      "description": "Majors open as drafts with no automerge, so a person reads them before they ship.",
      "matchUpdateTypes": ["major"],
      "draftPR": true,
      "automerge": false
    },
    {
      "description": "Updates to files under .github/ (the pipeline pin and the release actions) change CI itself: drafts with no automerge.",
      "matchFileNames": [".github/**"],
      "draftPR": true,
      "automerge": false
    }
  ],
  "customDatasources": {
    "chrome-for-testing-beta": {
      "defaultRegistryUrlTemplate": "https://googlechromelabs.github.io/chrome-for-testing/last-known-good-versions.json",
      "transformTemplates": ["{\"releases\": [{\"version\": channels.Beta.version}]}"]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^package\\.json$/"],
      "matchStrings": ["\"chrome\":\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+\\.\\d+)\""],
      "depNameTemplate": "chrome-for-testing",
      "datasourceTemplate": "custom.chrome-for-testing-beta",
      "versioningTemplate": "loose"
    }
  ]
}
