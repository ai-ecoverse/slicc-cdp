{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>ai-ecoverse/slicc-shared-web"],
  "packageRules": [
    {
      "matchManagers": ["npm", "cargo"],
      "matchPackageNames": ["@ai-ecoverse/slicc-browsers", "slicc-browsers"],
      "groupName": "slicc-browsers catalog and vectors",
      "groupSlug": "slicc-browsers-catalog-vectors",
      "rangeStrategy": "bump"
    },
    {
      "description": "sliccy-browser pins slicc-cdp to the certified version by hand.",
      "matchFileNames": ["packages/sliccy-browser/package.json"],
      "matchPackageNames": ["@ai-ecoverse/slicc-cdp"],
      "enabled": false
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["ai-ecoverse/slicc-shared-web"],
      "additionalBranchPrefix": "workflow-",
      "commitMessageTopic": "slicc-shared-web reusable workflows",
      "semanticCommitType": "ci"
    },
    {
      "description": "Changes that reach the shipped wasm or binaries wait for the PR certification: Renovate's pull requests aren't drafts, so cert-review-pr reviews them, and Renovate merges only when every check, cert-review included, is green.",
      "matchManagers": ["cargo"],
      "platformAutomerge": false
    },
    {
      "description": "Runtime npm dependencies of the published package wait for the PR certification the same way.",
      "matchManagers": ["npm"],
      "matchFileNames": ["package.json"],
      "matchDepTypes": ["dependencies", "optionalDependencies", "peerDependencies"],
      "platformAutomerge": false
    },
    {
      "description": "Workflow and action bumps that build or publish the shipped artifacts wait for the PR certification the same way.",
      "matchManagers": ["github-actions"],
      "platformAutomerge": false
    }
  ],
  "customDatasources": {
    "chrome-for-testing-beta": {
      "defaultRegistryUrlTemplate": "https://googlechromelabs.github.io/chrome-for-testing/last-known-good-versions.json",
      "transformTemplates": ["{\"releases\": [{\"version\": channels.Beta.version}]}"]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^package\\.json$/"],
      "matchStrings": ["\"chrome\":\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+\\.\\d+)\""],
      "depNameTemplate": "chrome-for-testing",
      "datasourceTemplate": "custom.chrome-for-testing-beta",
      "versioningTemplate": "loose"
    }
  ]
}
