{
  "branches": ["main"],
  "plugins": [
    [
      "@semantic-release/commit-analyzer",
      {
        "preset": "angular",
        "releaseRules": [
          { "scope": "sliccy-browser", "release": false },
          {
            "type": "fix",
            "scope": "deps",
            "subject": "update dependency @ai-ecoverse/slicc-cdp*",
            "release": false
          }
        ]
      }
    ],
    "@semantic-release/release-notes-generator",
    "@semantic-release/npm",
    ["@semantic-release/github", { "draftRelease": true }]
  ]
}
