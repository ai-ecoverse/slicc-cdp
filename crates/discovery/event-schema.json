{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ai-ecoverse/slicc-cdp/blob/main/crates/discovery/event-schema.json",
  "title": "DiscoveryEvent",
  "type": "object",
  "required": ["v", "standard", "origin", "url", "via", "page", "targetId", "status", "summary"],
  "properties": {
    "v": {
      "type": "integer",
      "const": 1
    },
    "standard": {
      "type": "string"
    },
    "origin": {
      "type": "string",
      "format": "uri"
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "via": {
      "type": "string",
      "enum": ["link-header", "html-link", "well-known", "page-api", "response"]
    },
    "page": {
      "type": "string",
      "format": "uri"
    },
    "targetId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["valid", "invalid"]
    },
    "summary": {},
    "reason": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
